Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.php

# ----------------------------------------------------------------
# Block dotfiles (.env, .git, .htpasswd, .DS_Store, …) entirely.
# Files served from /.well-known/ have ordinary basenames (e.g.
# security.txt) so they remain publicly reachable.
# ----------------------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ----------------------------------------------------------------
# Block secrets, databases, dumps, logs, backups and editor/OS noise.
# Note: each alternative is matched anywhere in the name so timestamped
# backups like "scanner.php.bak.20260612120212" are also caught.
# ----------------------------------------------------------------
<FilesMatch "(\.bak|\.backup|\.old|\.orig|\.swp|\.tmp|\.db|\.sqlite|\.sqlite3|\.sql|\.log|\.env|\.ini|\.lock|\.zip)(\.|$)">
    Require all denied
</FilesMatch>

<FilesMatch "^(config\.php|composer\.(json|lock)|package(-lock)?\.json|README\.md|AGENTS\.md|VERSION)$">
    Require all denied
</FilesMatch>

# ----------------------------------------------------------------
# Deny direct web access to non-public directories.
# ----------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/    - [F,L]
    RewriteRule ^src/     - [F,L]
    RewriteRule ^scripts/ - [F,L]
    RewriteRule (^|/)\.git/ - [F,L]
    # Block the HTTP TRACE method (cross-site tracing / XST).
    RewriteCond %{REQUEST_METHOD} ^TRACE [NC]
    RewriteRule .* - [F,L]
</IfModule>

# ----------------------------------------------------------------
# Baseline security headers (defense in depth; PHP also sets these).
# ----------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# Static assets are versioned from index.php using filemtime query strings.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg)$">
        Header always set Cache-Control "public, max-age=604800, immutable"
    </FilesMatch>
</IfModule>

# Hidangkan skrip audit sebagai teks biasa + paksa muat turun (bukan dijalankan).
<FilesMatch "^audit\.sh$">
    ForceType text/plain
    Header set Content-Disposition "attachment; filename=audit.sh"
    Header set Cache-Control "public, max-age=3600"
</FilesMatch>

# Ebook PDF — benarkan muat turun.
<FilesMatch "\.pdf$">
    Header set Content-Disposition "attachment"
    Header set Cache-Control "public, max-age=86400"
</FilesMatch>
