SECSCAN_DASHBOARD_PASSWORD_HASH=
SECSCAN_IP_HASH_SALT=replace-with-a-long-random-secret
SECSCAN_DATA_DIR=/absolute/path/outside/public/webroot
SECSCAN_DB_PATH=/absolute/path/outside/public/webroot/secscan.db
SECSCAN_SCAN_RATE_LIMIT=50
SECSCAN_SCAN_RATE_WINDOW=86400
SECSCAN_API_RATE_LIMIT=5
SECSCAN_API_RATE_WINDOW=60
SECSCAN_MAX_URL_LENGTH=2048
SECSCAN_CVE_WINDOW_DAYS=120
SECSCAN_CVE_CACHE_TTL=86400

# --- Trusted proxies (IMPORTANT for correct rate limiting) ---
# Forwarded client-IP headers (CF-Connecting-IP, X-Real-IP, X-Forwarded-For) are
# spoofable, so they are IGNORED by default and REMOTE_ADDR is used. If this app
# sits behind a reverse proxy / load balancer / CDN, list the proxy IPs or CIDR
# ranges here (comma-separated, IPv4 or IPv6) so the real client IP is honoured.
SECSCAN_TRUSTED_PROXIES=
# Behind Cloudflare? Set to 1 to trust Cloudflare's published edge ranges
# (so CF-Connecting-IP is used). Leave 0 if you are not behind Cloudflare.
SECSCAN_TRUST_CLOUDFLARE=0

# Set to 1 ONLY if you must run scripts/preflight.php via the web (it exposes
# deployment details). Leave unset/0 to keep it CLI-only.
SECSCAN_ALLOW_WEB_PREFLIGHT=0

# --- Authenticated scanning ---
# Set to 1 to let the API/UI accept a session cookie and auth headers so scans
# can run behind a login. OFF by default: a public, unauthenticated endpoint
# that forwards arbitrary credentials to arbitrary hosts is an abuse vector.
# Enable ONLY on an access-controlled deployment (e.g. behind your own auth).
SECSCAN_ALLOW_AUTH_SCAN=0
