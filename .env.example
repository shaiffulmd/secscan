SECSCAN_DASHBOARD_PASSWORD_HASH=
## Optional deployment override. Otherwise update the root VERSION file each release.
SECSCAN_APP_VERSION=
SECSCAN_IP_HASH_SALT=replace-with-a-long-random-secret
SECSCAN_DATA_DIR=/absolute/path/outside/public/webroot
SECSCAN_DB_PATH=/absolute/path/outside/public/webroot/secscan.db
SECSCAN_SCAN_RATE_LIMIT=50
SECSCAN_SCAN_RATE_WINDOW=86400
SECSCAN_MAX_REQUEST_BYTES=65536
# Had memori untuk body halaman utama dan setiap probe tambahan.
SECSCAN_TARGET_MAX_RESPONSE_BYTES=2097152
SECSCAN_PROBE_MAX_RESPONSE_BYTES=262144
SECSCAN_RATE_LIMIT_MAX_KEYS=10000
# IP owner/admin yang boleh bypass quota scan. Guna IP pejabat/VPN atau CIDR.
# Contoh: SECSCAN_OWNER_BYPASS_IPS=203.0.113.10,2001:db8::/64
SECSCAN_OWNER_BYPASS_IPS=
# Tempoh bypass sementara selepas admin berjaya login dashboard, dalam saat.
SECSCAN_OWNER_BYPASS_TTL=3600
SECSCAN_API_RATE_LIMIT=5
SECSCAN_API_RATE_WINDOW=60
# UI dan API kini berkongsi SECSCAN_SCAN_RATE_LIMIT/WINDOW. Dua pemboleh ubah
# API di atas dikekalkan untuk keserasian konfigurasi lama tetapi tidak digunakan.
SECSCAN_REPORT_RATE_LIMIT=30
SECSCAN_REPORT_RATE_WINDOW=60
SECSCAN_REPORT_LOG_MAX_BYTES=5242880
# Optional HTTPS override for DB-IP Lite CSV. Leave blank to use the current
# monthly DB-IP country database download.
SECSCAN_GEOIP_UPDATE_URL=
SECSCAN_MAX_URL_LENGTH=2048
SECSCAN_CVE_WINDOW_DAYS=120
SECSCAN_CVE_CACHE_TTL=86400

# --- TLS probe timeouts (saat) ---
# Satu scan buka banyak handshake ssl:// (checkTLS, cipher, ECDHE, PFS, cert
# chain). Had ini elak host lambat / di belakang WAF menyebabkan "SSL connection
# timeout" pada keseluruhan scan. PHASE_BUDGET = jumlah masa untuk semua probe
# TLS; PRIMARY_TIMEOUT = handshake utama; PROBE_TIMEOUT = setiap probe lain.
# PRIMARY/PROBE diketatkan supaya tidak melebihi PHASE_BUDGET.
SECSCAN_TLS_PHASE_BUDGET=25
SECSCAN_TLS_PRIMARY_TIMEOUT=10
SECSCAN_TLS_PROBE_TIMEOUT=5

# --- Optional VPS scanner worker ---
# Keep "local" until worker.php is deployed on a separate VPS. To enable remote
# scanning, set these values on BOTH servers (the shared secret must be a random
# value of at least 32 characters and never be committed).
SECSCAN_SCANNER_MODE=local
SECSCAN_WORKER_URL=https://scanner-vps.example/worker.php
SECSCAN_WORKER_SHARED_SECRET=
SECSCAN_WORKER_TIMEOUT=240
SECSCAN_WORKER_SCAN_TIMEOUT=300
SECSCAN_WORKER_MAX_RESPONSE_BYTES=8388608
# Set on the VPS worker to the IP/CIDR of security.apasaja.my (optional second
# control; HMAC authentication is still mandatory).
SECSCAN_WORKER_ALLOWED_CALLERS=

# --- Trusted proxies (IMPORTANT for correct rate limiting) ---
# Forwarded client-IP headers (CF-Connecting-IP, X-Real-IP, X-Forwarded-For) are
# spoofable, so they are IGNORED by default and REMOTE_ADDR is used. If this app
# sits behind a reverse proxy / load balancer / CDN, list the proxy IPs or CIDR
# ranges here (comma-separated, IPv4 or IPv6) so the real client IP is honoured.
SECSCAN_TRUSTED_PROXIES=
# Behind Cloudflare? Set to 1 to trust Cloudflare's published edge ranges
# (so CF-Connecting-IP is used). Leave 0 if you are not behind Cloudflare.
SECSCAN_TRUST_CLOUDFLARE=0

# Set to 1 ONLY if you must run scripts/preflight.php via the web (it exposes
# deployment details). Leave unset/0 to keep it CLI-only.
SECSCAN_ALLOW_WEB_PREFLIGHT=0

# --- Authenticated scanning ---
# Set to 1 to let the API/UI accept a session cookie and auth headers so scans
# can run behind a login. OFF by default: a public, unauthenticated endpoint
# that forwards arbitrary credentials to arbitrary hosts is an abuse vector.
# Enable ONLY on an access-controlled deployment (e.g. behind your own auth).
SECSCAN_ALLOW_AUTH_SCAN=0

# --- Extended non-destructive detection ---
# Set to 0 to disable the extended probe set: open redirect, CRLF/header
# injection, host-header injection, reflected-input (XSS) markers, error-based
# SQL injection, path traversal, source-map/schema exposure, cloud-bucket
# listing, HTTP/2-cleartext, MTA-STS policy fetch and CMS version endpoints.
# These send crafted but harmless requests (unique markers / quote characters /
# traversal paths) and never exploit, upload, write, or brute-force. Only run
# against targets you are authorised to test.
SECSCAN_ALLOW_ACTIVE_PROBES=1
# Per-scan ceiling on requests issued by the extended probes (parallel batches).
SECSCAN_ACTIVE_PROBE_MAX_REQUESTS=120

# --- Contact Us ---
# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# The form stores the full message encrypted in the SecScan database. Optional
# mail notification is sent only when a valid recipient is configured.
SECSCAN_CONTACT_ENCRYPTION_KEY=
SECSCAN_CONTACT_MAIL_TO=
SECSCAN_CONTACT_MAIL_FROM=
