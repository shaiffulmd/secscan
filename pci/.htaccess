Options -Indexes -MultiViews
ServerSignature Off

RewriteEngine On

# ----------------------------------------------------------------
# Rewrite rule: /api/scan -> api.php (no QSA to prevent query string injection)
# ----------------------------------------------------------------
RewriteRule ^api/scan$ api.php [L]

# ----------------------------------------------------------------
# Block access to sensitive files — deny at web server level
# ----------------------------------------------------------------
<FilesMatch "^(\.env|\.env\..*|\.git|composer\.(json|lock)|phpinfo\.php|\.htpasswd|\.htaccess)$">
    Require all denied
</FilesMatch>

# Block access to backup / swap files
<FilesMatch "\.(bak|backup|old|orig|swp|tmp|log)$">
    Require all denied
</FilesMatch>

# ----------------------------------------------------------------
# Security Headers
# ----------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always set X-XSS-Protection "0"

    # HSTS — ensures all requests (including static files + api.php) get the header,
    # complementing the PHP-level HSTS sent by index.php.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Remove server fingerprint headers
    Header always unset X-Powered-By
    Header always unset Server
    Header always unset X-Generator
    Header always unset X-AspNet-Version
</IfModule>

# ----------------------------------------------------------------
# Cache control: no caching for API responses
# ----------------------------------------------------------------
<FilesMatch "api\.php$">
    <IfModule mod_headers.c>
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------
# Cache static assets (CSS/JS) — they use ?v= cache busting in index.php
# ----------------------------------------------------------------
<FilesMatch "\.(css|js)$">
    <IfModule mod_headers.c>
        Header always set Cache-Control "public, max-age=604800, immutable"
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------
# Disable HTTP TRACE method (XST prevention)
# ----------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} ^TRACE
    RewriteRule .* - [F,L]
</IfModule>
